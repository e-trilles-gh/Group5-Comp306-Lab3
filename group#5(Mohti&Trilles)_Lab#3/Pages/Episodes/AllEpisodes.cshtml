@page
@model group_5_Mohti_Trilles__Lab_3.Pages.Episodes.AllEpisodesModel

<h2 class="mb-4">All Episodes</h2>

@if (Model.Episodes.Count == 0)
{
    <p>No episodes have been uploaded yet.</p>
}
else
{
    <div class="row">
        @foreach (var episode in Model.Episodes)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">

                        <h5 class="card-title">@episode.Title</h5>

                        <p class="text-muted">
                            Released: @episode.ReleaseDate.ToString("dd MMM yyyy")
                        </p>

                        <p>
                            Views: @episode.ViewerNumber
                        </p>

                        <video controls preload="metadata" width="100%">
                            <source
                                src="@Url.Page("/Episodes/AllEpisodes","Play",new{id=episode.EpisodeId})" >
                            Your brower does not support video playback.
                        </video>
                    </div>
                </div>
            </div>
        }
    </div>
}