@page
@model group_5_Mohti_Trilles__Lab_3.Pages.Episodes.EpisodeDetailsModel


<div class="container mt-4 mb-5">
    <div class="mb-4">
        <h2>@Model.Episode.Title</h2>

        <p class="text-muted">
            Host: @(Model.Episode.User?.Username ?? "Unknown")
            <br />
            Released: @Model.Episode.ReleaseDate.ToString("dd MMM yyyy")
            <br />
            Views: @Model.Episode.ViewerNumber
        </p>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <video controls preload="metadata" class="w-100">
                <source src="@Url.Page("/Episodes/EpisodeDetails","Play",new{id=Model.Episode.EpisodeId})"/>
                Your browser does not support video playback.
            </video>
        </div>
    </div>

    <hr />

    <h3 class="mb-3">Comments (@Model.Comments.Count)</h3>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Write a comment</h5>

            <form method="post"
                asp-page-handler="AddComment"
                asp-route-id="@Model.Episode.EpisodeId">

                <div class="mb-3">
                    <label for="commentText" class="form-label">Your comment</label>

                    <textarea
                        id="commentText"
                        name="commentText"
                        rows="3"
                        maxlength="2000"
                        placeholder="Write your comment"
                        required></textarea>

                    <div class="form-text">Maximum 2,000 characters.</div>
                 </div>

                 <button type="submit" class="btn btn-primary">Post Comment</button>
            </form>
        </div>
    </div>

    @if (Model.Comments.Count == 0)
    {
        <div class="alert alert-light border">
            No comments yet. Please add your comment.
        </div>
    }
    else
    {
        @foreach (var comment in Model.Comments)
        {
            bool isOwner = comment.UserId == Model.CurrentUserId;

            bool canModify = isOwner && comment.CreateDate <= DateTime.Now &&
            DateTime.Now < comment.CreateDate.AddHours(24);

            bool isEditing = Model.EditingCommentId == comment.CommentId;

            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <strong>
                                @(comment.User?.Username ?? "Unknown User")
                            </strong>

                            <div class="text-muted small">
                                @(comment.CreateDate.ToString("dd MMM yyyy HH:mm"))
                            </div>
                        </div>

                        @if (isOwner)
                        {
                            <span class="badge bg-secondary">Your comment</span>
                        }
                    </div>

                    @if (isEditing && canModify)
                    {
                        <form method="post"
                            asp-page-handler="EditComment"
                            asp-route-id="@Model.Episode.EpisodeId"
                            asp-route-commentId="@comment.CommentId">
                            <div class="mb-3">
                                <textarea name="commentText"
                                    class="form-control"
                                    rows="3"
                                    maxlength="2000"
                                    required>@comment.CommentText</textarea>
                            </div>

                            <button type="submit" class="btn btn-success btn-sm">Save Changes</button>

                            <a asp-page="/Episodes/EpisodeDetails"
                                asp-route-id="@Model.Episode.EpisodeId"
                                class="btn btn-secondary btn-sm">Cancel</a>
                        </form>
                    }
                    else
                    {
                        <p class="card-text">@comment.CommentText</p>

                        @if (canModify)
                        {
                            <div class="d-flex gap-2">
                                <a asp-page="/Episodes/EpisodeDetails"
                                    asp-route-id="@Model.Episode.EpisodeId"
                                    asp-route-editCommentId="@comment.CommentId"
                                    class="btn btn-outline-primary btn-sm">Edit</a>

                                <form method="post"
                                    asp-page-handler="DeleteComment"
                                    asp-route-id="@Model.Episode.EpisodeId"
                                    asp-route-commentId="@comment.CommentId"
                                    onsubmit="return confirm('Are you sure you want to delete this comment?');">
                                    
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                
                                </form>
                            </div>
                        }
                        else
                        {
                            @if (isOwner)
                            {
                                <small class="text-muted">
                                    The 24-hour editing and deletion period has expired.
                                </small>
                            }
                        }
                    }
                </div>
            </div>
        }
    }

    <a asp-page="/Episodes/AllEpisodes" class="btn btn-secondary mt-3">Back to All Episodes</a>
</div>
